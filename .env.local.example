# InstantDB Configuration
# Get your admin key from: https://instantdb.com/dash
NEXT_PUBLIC_INSTANT_APP_ID=f0827431-76de-4f51-a2c3-bae2e1558bcc
INSTANT_ADMIN_KEY=your-admin-key-here

# Owner Email (for permissions)
# This email will have write access to all data
OWNER_EMAIL=your-email@example.com

# n8n Configuration (Optional)
# URL of your n8n events webhook
N8N_EVENTS_URL=https://your-n8n-instance.com/webhook/events

# Formbricks Configuration (Optional)
# Shared secret for authenticating Formbricks webhook requests
FORMBRICKS_SHARED_SECRET=your-shared-secret-here

# Vercel Blob Storage
# Get token from: Vercel Dashboard > Storage > Blob > Settings
# When deployed on Vercel, this token is automatically available
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token-here

# Resend Webhook Verification (Required for /api/resend/webhook)
# Get this from: Resend Dashboard > Webhooks > [your webhook] > Signing secret
RESEND_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
